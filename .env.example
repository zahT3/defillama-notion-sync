# Copy to .env and fill in. Do NOT commit .env.

# Notion integration token. Create one at https://www.notion.so/my-integrations
# then SHARE the target database with the integration (... menu -> Connections).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database ID for 「🎯 目标公司狩猎名单」.
# Get it from the database URL — the part right after `notion.so/`.
# Example URL: https://www.notion.so/e0ad084079de4af0bee644d51b28e555?v=...
# Then ID = e0ad084079de4af0bee644d51b28e555
NOTION_DATABASE_ID=e0ad084079de4af0bee644d51b28e555
